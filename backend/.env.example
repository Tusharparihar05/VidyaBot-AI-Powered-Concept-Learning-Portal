# ─── Core Server Config ───────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/vidyabot?retryWrites=true&w=majority&appName=Cluster0
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_here
PORT=8000

# ─── Rate limiting (chat questions per UTC day, requires Redis) ───────────────
# DAILY_QUESTION_LIMIT=20

# ─── Video microservice (Manim) ─────────────────────────────────────────────
VIDEO_SERVICE_URL=http://localhost:8001
# Set to 0 to disable automatic Manim job after each chat answer (default: enabled)
# VIDEO_PREFETCH=0

# ─── AI API (using NVIDIA NIM — OpenAI-compatible) ───────────────────────────
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# ─── Creatomate (Animation Pipeline — Type 2) ────────────────────────────────
CREATOMATE_API_KEY=your_creatomate_api_key_here
CREATOMATE_TEMPLATE_ID=your_template_id_here

# ─── HeyGen (Avatar Video Pipeline — Type 3) ─────────────────────────────────
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=Angela-inblackskirt-20220820
HEYGEN_VOICE_ID=your_voice_id_here
